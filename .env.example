# Copie para .env. Os valores abaixo servem só para desenvolvimento local;
# na nuvem, gere chaves novas (openssl rand -hex 32) e use os segredos da plataforma.

# MongoDB. Sem MONGODB_URI, o compose usa o Mongo local (mongodb://mongo:27017)
# e o perfil local do Spring usa mongodb://localhost:27017.
# MONGODB_URI=mongodb+srv://USUARIO:SENHA_CODIFICADA@SEU_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=payflow

# Chave compartilhada com o BFF e a Function deliver-webhook (32 a 256 caracteres).
PAYFLOW_INTERNAL_KEY=local-dev-internal-key-0123456789abcdef

# Chave do lojista demo (32 a 256 caracteres).
DEMO_MERCHANT_API_KEY=local-dev-merchant-key-0123456789abcdef

API_PORT=8081
MERCHANT_SERVICE_IMAGE=payflow/merchant-service:dev
